# ===================================================================
# Tyse Scrutiny - Development Server Configuration
#
# Copiar a .env.dev y completar los valores
#   cp .env.dev.example .env.dev
# ===================================================================

# --- Docker Registry ---
REGISTRY=ghcr.io
GATEWAY_IMAGE=manuelmottaherrera/tyse-scrutiny-gateway
DIVIPOL_IMAGE=manuelmottaherrera/tyse-scrutiny-micro-divipol
SCRUTINY_IMAGE=manuelmottaherrera/tyse-scrutiny-micro-scrutiny
MOCK_IMAGE=manuelmottaherrera/tyse-scrutiny-mock-pipeline
NOTIFICATION_IMAGE=manuelmottaherrera/tyse-scrutiny-micro-notification

# --- Image Tag (develop, main, v1.0.0, etc.) ---
IMAGE_TAG=develop

# --- Infrastructure Ports ---
CONSUL_PORT=8510
KAFKA_PORT=9102
MINIO_API_PORT=9000
MINIO_UI_PORT=9001
MAILHOG_SMTP_PORT=1035
MAILHOG_UI_PORT=8035
NGINX_HTTP_PORT=80

# --- Database Ports (expuestos a LAN para perfil local-dev) ---
GATEWAY_DB_PORT=5432
DIVIPOL_DB_PORT=5433
SCRUTINY_DB_PORT=5434

# --- Gateway Database ---
GATEWAY_DB_NAME=tysescrutinygateway
GATEWAY_DB_USER=tysescrutinygateway
GATEWAY_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Divipol Database ---
DIVIPOL_DB_NAME=tysescrutinymicrodivipol
DIVIPOL_DB_USER=tysescrutinymicrodivipol
DIVIPOL_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Scrutiny Database ---
SCRUTINY_DB_NAME=tyseScrutinyMicroScrutiny
SCRUTINY_DB_USER=tyseScrutinyMicroScrutiny
SCRUTINY_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- JWT Secret (REQUIRED - generar con: openssl rand -base64 64) ---
JWT_SECRET=CHANGE_ME

# --- CORS (URLs permitidas, separadas por coma) ---
CORS_ALLOWED_ORIGINS=http://192.168.0.58,http://192.168.0.58:80

# --- Google reCAPTCHA (opcional en dev) ---
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=

# --- MinIO ---
MINIO_ROOT_USER=tyseadmin
MINIO_ROOT_PASSWORD=tyseadmin123
