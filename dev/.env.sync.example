# ===================================================================
# Configuración de sincronización Producción → Desarrollo
#
# Copiar a .env.sync y completar con datos reales de producción
#   cp .env.sync.example .env.sync
#
# NUNCA commitear .env.sync — contiene credenciales de producción
# ===================================================================

# --- Conexión a BD de Producción (AWS RDS) ---
PROD_DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
PROD_DB_PORT=5432
PROD_DB_USER=postgres
PROD_DB_PASSWORD=CHANGE_ME

# --- Nombres de BD en Producción (si difieren de dev) ---
PROD_GATEWAY_DB_NAME=tysescrutinygateway
PROD_DIVIPOL_DB_NAME=tysescrutinymicrodivipol
PROD_SCRUTINY_DB_NAME=tyseScrutinyMicroScrutiny
